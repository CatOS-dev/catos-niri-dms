// Profile-scoped user window and layer rules.
// Catdot seeds this file once and does not manage later edits.

// Example:
// window-rule {
//     match app-id="example"
//     open-floating true
// }

// If you enable "Duplicate Wallpaper with Blur" in DMS, uncomment this
// later rule so the normal wallpaper remains sharp on the desktop and the
// blurred duplicate is used for the overview backdrop. Re-comment it when
// disabling the DMS option to show the normal wallpaper in the overview.
// layer-rule {
//     match namespace="^quickshell$"
//     place-within-backdrop false
// }
