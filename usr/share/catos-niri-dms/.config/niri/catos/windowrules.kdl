// CatOS application defaults and narrowly scoped compatibility rules.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"^org\.gnome\."#
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}

window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id=r#"^org\.gnome\.FileRoller$"#
    match app-id=r#"^xdg-desktop-portal$"#
    match app-id=r#"^com\.gabm\.satty$"#
    match app-id=r#"^imv$"#
    match app-id=r#"^btrfs-assistant$"#
    match app-id=r#"^thunar$"# title=r#"^(File Operation Progress|文件操作进度)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^steam$"# title=r#"^(Friends List|好友列表)$"#
    default-column-width { proportion 0.20; }
}

window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}

window-rule {
    match app-id=r#"firefox$"# title=r#"^Picture-in-Picture$"#
    match app-id="zoom"
    open-floating true
}

window-rule {
    match app-id="mpv"
    match app-id="io.github.celluloid_player.Celluloid"
    match app-id="celluloid"
    opacity 1.0
}

window-rule {
    match app-id=r#"^com\.danklinux\.dms$"#
    open-floating true
}
